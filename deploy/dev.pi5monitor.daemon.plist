<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.pi5monitor.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/var/root/pi5monitor/pi5mon</string>
    <string>/var/root/pi5monitor</string>
  </array>
  <!-- On demand only: launchd holds the socket and starts pi5mon on the first connection;
       pi5mon exits after 40 s without requests. No RunAtLoad, no KeepAlive. -->
  <key>Sockets</key>
  <dict>
    <key>Listener</key>
    <dict>
      <key>SockNodeName</key><string>127.0.0.1</string>
      <key>SockServiceName</key><string>8899</string>
      <key>SockType</key><string>stream</string>
      <key>SockFamily</key><string>IPv4</string>
    </dict>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/var/root</string>
  </dict>
  <key>StandardOutPath</key><string>/var/root/pi5monitor/log.txt</string>
  <key>StandardErrorPath</key><string>/var/root/pi5monitor/log.txt</string>
</dict>
</plist>
